@using ExamensarbeteNy.ViewModels;
@model AnnonsViewModel

@{
    ViewData["Title"] = "Skapa Annons";
}

<h1>Skapa Annons</h1>

<form asp-action="SkapaProdukt" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Namn"></label>
        <input asp-for="Namn" class="form-control" />
        <span asp-validation-for="Namn" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Beskrivning"></label>
        <input asp-for="Beskrivning" class="form-control" />
        <span asp-validation-for="Beskrivning" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Pris"></label>
        <input asp-for="Pris" class="form-control" />
        <span asp-validation-for="Pris" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BildUrl"></label>
        <input asp-for="BildUrl" class="form-control" />
        <span asp-validation-for="BildUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="KategoriId"></label>
        <select asp-for="KategoriId" class="form-control" asp-items="Model.Kategorier">
            <option value="">Välj en kategori...</option>
        </select>
        <span asp-validation-for="KategoriId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ChildKategoriId"></label>
        <select asp-for="ChildKategoriId" class="form-control" asp-items="Model.ChildKategorier">
            <option value="">Välj en underkategori...</option>
        </select>
        <span asp-validation-for="ChildKategoriId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Skapa</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<a href="@Url.Action("Index", "Home")" class="btn btn-primary">Till startsidan</a>

